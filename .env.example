# ====== brandadagio 環境変数 ======
# .env.local にコピーして値を設定してください。本番は Vercel の環境変数へ。

# --- Payload ---
# 32 文字以上のランダム文字列（例: `openssl rand -hex 32`）
PAYLOAD_SECRET=
# 公開URL（本番は https://your-domain）
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Database（PostgreSQL）---
# アプリが実際に使う接続先。
# ローカル開発では scripts/pg.mjs で起動するポータブル版 PostgreSQL を指す：
#   DATABASE_URI=postgres://postgres@127.0.0.1:5433/brandadagio
# 本番（Vercel / VPS）では Neon などの接続文字列。
# リモートの場合、末尾は sslmode=verify-full 推奨（pg の非推奨警告を回避し、検証強度も維持）
DATABASE_URI=postgres://postgres@127.0.0.1:5433/brandadagio

# `npm run db:sync` のコピー元（本番DB）。ローカル開発でのみ使用し、書き込みは行わない。
REMOTE_DATABASE_URI=postgres://user:password@host/dbname?sslmode=verify-full

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# --- 画像保存 ---
# Payload のアップロード先。デプロイのたびに消えないよう、本番ではリリース
# ディレクトリの外を指す（VPS: /var/lib/brandadagio/media）。
# 未設定ならプロジェクト直下の media/ に保存（ローカル開発用）。
MEDIA_DIR=

# Vercel Blob のトークン。VPS ではディスク保存なので空のままでよい。
BLOB_READ_WRITE_TOKEN=
